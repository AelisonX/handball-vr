{
  "name": "handball-vr",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test --test-force-exit tests/*.test.ts",
    "server": "node server/relay.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:unit": "tsx --test tests/handball.test.ts tests/revision2.test.ts tests/interaction.test.ts tests/peer-world.test.ts tests/ice.test.ts tests/revision3.test.ts",
    "desktop": "npm run build && node scripts/standalone.mjs",
    "test:online": "node tests/online.mjs",
    "test:ai": "node --import tsx tests/ai-simulation.mjs",
    "test:browser:offline": "node tests/browser-offline.mjs"
  },
  "dependencies": {
    "three": "^0.180.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^26.6.6",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  }
}
